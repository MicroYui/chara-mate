{
  "name": "chara-mate",
  "productName": "CharaMate",
  "version": "0.1.0",
  "description": "A desktop AI companion built on one Electron runtime.",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.mjs",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.27.7": true
  },
  "scripts": {
    "browser:install": "playwright install chromium",
    "start": "electron-forge start",
    "build": "node scripts/build.mjs",
    "package": "npm run browser:install && electron-forge package",
    "make": "npm run browser:install && electron-forge make",
    "smoke:dev": "node scripts/smoke-electron.mjs dev",
    "smoke:package": "node scripts/smoke-electron.mjs packaged",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contract": "vitest run --project contract",
    "test:focused": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test:contract",
    "verify:offline": "npm run check:fast && npm run test:focused && npm run test:integration",
    "verify:phase0": "npm run verify:offline && npm run build && npm run smoke:dev && npm run package && npm run smoke:package && npm run test:e2e",
    "test:live": "vitest run --project live",
    "test:benchmark": "node scripts/optional-suite.mjs benchmark"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-virtual": "3.14.8",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.1",
    "cron-parser": "5.6.2",
    "katex": "0.18.1",
    "lucide-react": "1.26.0",
    "mermaid": "11.16.0",
    "openai": "6.49.0",
    "pino": "10.3.1",
    "pixi.js": "8.19.0",
    "playwright-core": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.3.1",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.5",
    "vitest": "4.1.10"
  }
}
